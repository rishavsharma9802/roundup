{
  "name": "roundup",
  "version": "1.0.0",
  "private": true,
  "description": "Roundup - rule-driven Chrome tab grouping with a learning site catalog. No server, no account, no analytics.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "zip": "npm run build && npm run verify && rm -f roundup.zip && cd dist && zip -qr ../roundup.zip . -x '*.map'",
    "smoke": "node scripts/smoke-test.mjs",
    "verify": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rishavsharma9802/roundup.git"
  },
  "license": "MIT",
  "author": "Rishav Kumar Sharma"
}
